{
  "manifest_version": 3,
  "name": "Twitter Twemoji Local Replacer",
  "version": "1.0.1",
  "description": "A native Twemoji replacement plugin based on embedded Base64.",
  "icons": {
    "16": "src/icon-16.png",
    "32": "src/icon-32.png",
    "48": "src/icon-48.png",
    "128": "src/icon-128.png"
  },
  "author": "Shirley Auspice",
  "browser_specific_settings": {
    "gecko": {
      "id": "{9fc8c38a-18c5-4aff-8e07-eb44752b4636}",
      "update_url": "https://raw.githubusercontent.com/auspiceshirley/twitter-twemoji-local-replacer/master/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/emoji_data_1.js",
        "src/emoji_data_2.js",
        "src/emoji_data_3.js",
        "src/emoji_data_4.js",
        "src/emoji_data_5.js",
        "src/emoji_data_6.js",
        "src/emoji_data_7.js",
        "src/emoji_data_8.js",
        "main.js"
      ],
      "run_at": "document_end"
    }
  ]
}